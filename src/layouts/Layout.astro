---
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { ClientRouter } from 'astro:transitions';
import DotField from '../components/DotField.astro';

interface Props {
	title: string;
    description?: string;
    ogImage?: string;
    article?: {
        publishedTime?: string;
        modifiedTime?: string;
        tags?: string[];
    };
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description = lang === 'es' 
    ? "Victor Ruiz - Desarrollador Fullstack | Portfolio" 
    : "Victor Ruiz - Fullstack Developer | Portfolio",
    ogImage,
    article
} = Astro.props;

const homeLink = lang === 'es' ? '/' : '/en';
const blogLink = lang === 'es' ? '/blog' : '/en/blog';

// SEO: Canonical URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// SEO: Hreflang alternates
const currentPath = Astro.url.pathname;
const esPath = currentPath.startsWith('/en') 
    ? currentPath.replace(/^\/en/, '') || '/' 
    : currentPath;
const enPath = currentPath.startsWith('/en') 
    ? currentPath 
    : `/en${currentPath === '/' ? '' : currentPath}`;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://fedhinen.me';
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).toString() : undefined;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<!-- SEO: Basic Meta -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Victor Ruiz" />
		<link rel="canonical" href={canonicalURL.toString()} />

		<!-- SEO: Hreflang alternates for i18n -->
		<link rel="alternate" hreflang="es" href={`${siteUrl}${esPath}`} />
		<link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}`} />
		<link rel="alternate" hreflang="x-default" href={`${siteUrl}${esPath}`} />

		<!-- SEO: Open Graph -->
		<meta property="og:type" content={article ? 'article' : 'website'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL.toString()} />
		<meta property="og:site_name" content="Victor Ruiz" />
		<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
		{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
		{article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
		{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
		{article?.tags?.map(tag => <meta property="article:tag" content={tag} />)}

		<!-- SEO: Twitter Card -->
		<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#ffffff" />

		<!-- Generator -->
		<meta name="generator" content={Astro.generator} />

		<!-- View Transitions -->
        <ClientRouter />

		<!-- Fonts (swap ensures text visible during load) -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Caveat:wght@400;700&display=swap" rel="stylesheet" />

		<!-- SEO: Structured Data (JSON-LD) -->
		{!article && (
			<script type="application/ld+json" set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "Person",
				"name": "Victor Ruiz",
				"jobTitle": lang === 'es' ? "Desarrollador Fullstack" : "Fullstack Developer",
				"url": siteUrl,
				"sameAs": [
					"https://github.com/fedhinen"
				],
				"email": "victor.adrian.ruiz.espindola@gmail.com"
			})} />
		)}
		{article && (
			<script type="application/ld+json" set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "Article",
				"headline": title,
				"description": description,
				"author": {
					"@type": "Person",
					"name": "Victor Ruiz",
					"url": siteUrl
				},
				"datePublished": article.publishedTime,
				"dateModified": article.modifiedTime || article.publishedTime,
				...(ogImageUrl && { "image": ogImageUrl }),
				"mainEntityOfPage": {
					"@type": "WebPage",
					"@id": canonicalURL.toString()
				}
			})} />
		)}
	</head>
	<body class="bg-bg text-text min-h-screen flex flex-col selection:bg-black selection:text-white relative overflow-x-hidden font-['Inter',sans-serif]">
        <!-- DotField: full-viewport background effect -->
        <DotField />

        <header class="py-4 md:py-6 px-4 md:px-8 max-w-5xl mx-auto w-full flex justify-center md:justify-between items-center z-10 relative">
            <a href={homeLink} class="hidden md:block text-xl font-bold text-primary no-underline hover:opacity-70 transition-opacity tracking-tighter bg-white/60 backdrop-blur-sm px-2 py-0.5 rounded-lg">
                VR
            </a>
            <nav class="flex gap-1 md:gap-4 text-xs md:text-sm font-medium items-center bg-white/75 backdrop-blur-md px-3 md:px-4 py-2 rounded-full border border-black/8 shadow-sm text-primary" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
                <a href={homeLink} class="md:hidden hover:text-black hover:bg-white/80 px-2 py-1.5 rounded-full transition-all text-text-muted" aria-label="Home">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                </a>
                <a href={`${homeLink}#experience`} class="hover:text-black hover:bg-white/80 px-2 md:px-3 py-1.5 rounded-full transition-all text-text-muted">{t('nav.experience')}</a>
                <a href={`${homeLink}#projects`} class="hover:text-black hover:bg-white/80 px-2 md:px-3 py-1.5 rounded-full transition-all text-text-muted">{t('nav.projects')}</a>
                <a href={blogLink} class="hover:text-black hover:bg-white/80 px-2 md:px-3 py-1.5 rounded-full transition-all text-text-muted">{t('nav.blog')}</a>
                <div class="flex gap-2 ml-2 border-l border-gray-300 pl-2">
                    <a href="/" class={`text-xs font-bold px-2 py-1 rounded transition-colors ${lang === 'es' ? 'bg-black text-white' : 'text-accent hover:text-black'}`} aria-label="Español">ES</a>
                    <a href="/en" class={`text-xs font-bold px-2 py-1 rounded transition-colors ${lang === 'en' ? 'bg-black text-white' : 'text-accent hover:text-black'}`} aria-label="English">EN</a>
                </div>
            </nav>
        </header>
		<main class="flex-1 w-full max-w-5xl mx-auto px-4 md:px-8 z-10 relative flex flex-col">
			<slot />
		</main>
        <footer class="py-12 mt-12 text-center text-sm text-text-muted z-10 relative border-t border-gray-200 bg-white/60 backdrop-blur-sm">
            &copy; {new Date().getFullYear()} Victor Ruiz. {t('footer.rights')}
        </footer>
	</body>
</html>
