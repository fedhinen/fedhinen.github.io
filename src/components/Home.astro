---
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import Experience from './Experience.astro';
import Projects from './Projects.astro';
import Education from './Education.astro';

interface Props {
    lang: 'es' | 'en';
}

const { lang } = Astro.props;
---

<Layout title="Victor Ruiz - Fullstack Developer Portfolio" description={lang === 'es' ? 'Victor Ruiz - Desarrollador Fullstack con experiencia en diseño, desarrollo y despliegue de aplicaciones web robustas.' : 'Victor Ruiz - Fullstack Developer with experience in designing, developing, and deploying robust web applications.'}>
    <Hero lang={lang} />
    <Experience lang={lang} />
    <Projects lang={lang} />
    <Education lang={lang} />
</Layout>
