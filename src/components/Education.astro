---
import { useTranslations } from '../i18n/utils';

interface Props {
    lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const education = [
    {
        school: "Universidad Tecnológica de Torreón",
        degree: { es: "TSU en Mecatrónica, Área Automatización", en: "TSU in Mechatronics, Automation Area" },
        date: { es: "Esperado 2028", en: "Expected 2028" },
        location: { es: "Torreón, México", en: "Torreón, Mexico" }
    },
    {
        school: "Colegio Nacional de Educación Profesional Técnica",
        degree: { es: "Técnico Bachiller en Química Industrial", en: "Technical Bachelor in Industrial Chemistry" },
        date: "2016 - 2019",
        location: { es: "Torreón, México", en: "Torreón, Mexico" }
    }
];
---

<section id="education" class="py-8 md:py-12">
    <div class="flex items-center gap-3 mb-10">
        <div class="h-px bg-gray-200 flex-1"></div>
        <h2 class="text-2xl font-bold text-primary tracking-tight">
             {t('section.education')}
        </h2>
        <div class="h-px bg-gray-200 flex-1"></div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {education.map((edu) => (
            <article class="card-soft p-4 md:p-8 flex flex-col justify-between">
                <div>
                    <h3 class="text-lg font-bold text-primary mb-2 text-pretty">{edu.school}</h3>
                    <div class="text-text-muted font-medium mb-1">{edu.degree[lang]}</div>
                    <div class="text-sm text-gray-400 flex items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        {edu.location[lang]}
                    </div>
                </div>
                <div class="mt-6 pt-4 border-t border-gray-100 flex justify-end">
                    <span class="inline-block px-3 py-1 bg-gray-50 rounded-full text-xs font-semibold text-gray-500 border border-gray-100">
                         {typeof edu.date === 'string' ? edu.date : edu.date[lang]}
                    </span>
                </div>
            </article>
        ))}
    </div>
</section>
