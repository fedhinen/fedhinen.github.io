---
import { useTranslations } from '../i18n/utils';

interface Props {
    lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const education = [
    {
        school: "Universidad Tecnológica de Torreón",
        degree: { es: "TSU en Mecatrónica, Área Automatización", en: "TSU in Mechatronics, Automation Area" },
        date: { es: "Esperado 2028", en: "Expected 2028" },
        location: { es: "Torreón, México", en: "Torreón, Mexico" }
    },
    {
        school: "Colegio Nacional de Educación Profesional Técnica",
        degree: { es: "Técnico Bachiller en Química Industrial", en: "Technical Bachelor in Industrial Chemistry" },
        date: "2016 - 2019",
        location: { es: "Torreón, México", en: "Torreón, Mexico" }
    }
];
---

<section id="education" class="py-16 md:py-24 scroll-mt-24">
    <div class="mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-primary tracking-tight">{t('section.education')}</h2>
    </div>

    <div>
        {education.map((edu) => (
            <article class="py-8 border-t border-gray-200/70 first:border-t-0">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h3 class="text-xl md:text-2xl font-bold text-primary tracking-tight text-pretty">{edu.school}</h3>
                    <span class="text-sm font-medium text-text-muted whitespace-nowrap">
                        {typeof edu.date === 'string' ? edu.date : edu.date[lang]}
                    </span>
                </div>
                <p class="text-base font-medium text-text-muted mt-1">{edu.degree[lang]}</p>
                <div class="text-sm text-gray-400 flex items-center gap-1.5 mt-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    {edu.location[lang]}
                </div>
            </article>
        ))}
    </div>
</section>
