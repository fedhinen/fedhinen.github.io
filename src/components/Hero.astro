---
import { getCollection } from "astro:content";
import { useTranslations } from "../i18n/utils";

interface Props {
    lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const certifications = await getCollection("certifications");
const badges = certifications
    .filter((c) => c.data.featured !== false)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<section
    class="hero-section relative min-h-[50vh] flex items-center py-16 md:py-24"
>
    <div
        class="w-full grid grid-cols-1 md:grid-cols-[1fr_auto] items-center gap-10 md:gap-16"
    >
        <!-- Left: name + role + links -->
        <div>
            <h1
                class="hero-name text-5xl md:text-7xl font-extrabold tracking-tighter text-primary text-balance"
                data-name="Victor Ruiz"
            >
                Victor Ruiz
            </h1>
            <p
                class="hero-role text-xl md:text-2xl text-text-muted mt-3 font-medium"
            >
                {t("hero.role")}
            </p>

            <div class="flex flex-wrap gap-3 mt-8">
                <a
                    href="mailto:victor.adrian.ruiz.espindola@gmail.com"
                    class="hero-link group inline-flex items-center gap-2"
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity"
                    >
                        <path
                            fill-rule="evenodd"
                            clip-rule="evenodd"
                            d="M3.75 5.25L3 6V18L3.75 18.75H20.25L21 18V6L20.25 5.25H3.75ZM4.5 7.6955V17.25H19.5V7.69525L11.9999 14.5136L4.5 7.6955ZM18.3099 6.75H5.68986L11.9999 12.4864L18.3099 6.75Z"
                            fill="#080341"></path>
                    </svg>
                    {t("hero.cta.email")}
                </a>
                <a
                    href="https://github.com/fedhinen"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hero-link group inline-flex items-center gap-2"
                >
                    <svg
                        viewBox="0 0 24 24"
                        class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity"
                        fill="currentColor"
                        ><path
                            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                        ></path></svg
                    >
                    GitHub
                </a>
                <a
                    href="/cv.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hero-link group inline-flex items-center gap-2"
                >
                    <svg
                        viewBox="0 0 24 24"
                        class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                        ></path><polyline points="14 2 14 8 20 8"
                        ></polyline></svg
                    >
                    {t("hero.cta.cv")}
                </a>
            </div>
        </div>

        <!-- Right: small badges -->
        {
            badges.length > 0 && (
                <aside class="flex md:flex-col items-center gap-4">
                    {badges.map((cert) => {
                        const Tag = cert.data.url ? "a" : "div";
                        const linkProps = cert.data.url
                            ? {
                                  href: cert.data.url,
                                  target: "_blank",
                                  rel: "noopener noreferrer",
                              }
                            : {};
                        return (
                            <Tag
                                {...linkProps}
                                class="group w-14 h-14 md:w-16 md:h-16 flex items-center justify-center opacity-70 hover:opacity-100 transition-opacity"
                                title={cert.data.name}
                            >
                                <img
                                    src={cert.data.image}
                                    alt={cert.data.name}
                                    width="64"
                                    height="64"
                                    loading="eager"
                                    decoding="async"
                                    class="max-w-full max-h-full object-contain transition-transform duration-300 group-hover:scale-110"
                                />
                            </Tag>
                        );
                    })}
                </aside>
            )
        }
    </div>
</section>

<style>
    /* Hero links: pill con fondo blanco semitransparente para contraste sobre el canvas */
    .hero-link {
        font-size: 0.875rem;
        font-weight: 500;
        color: #111111;
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 9999px;
        padding: 0.35rem 0.9rem;
        text-decoration: none;
        transition:
            background 0.2s ease,
            color 0.2s ease,
            border-color 0.2s ease;
        white-space: nowrap;
    }
    .hero-link:hover {
        background: rgba(255, 255, 255, 0.95);
        color: #000000;
        border-color: rgba(0, 0, 0, 0.18);
    }

    .hero-caret {
        display: inline-block;
        width: 0.06em;
        margin-left: 0.04em;
        background: currentColor;
        animation: caret-blink 1s step-end infinite;
    }
    @keyframes caret-blink {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0;
        }
    }
    .hero-role {
        transition: opacity 0.5s ease;
    }
    @media (prefers-reduced-motion: reduce) {
        .hero-caret {
            animation: none;
        }
    }
</style>

<script>
    const SESSION_KEY = "heroNameTyped";

    function initHero() {
        const el = document.querySelector<HTMLElement>(".hero-name");
        const role = document.querySelector<HTMLElement>(".hero-role");
        if (!el || el.dataset.twReady === "1") return;
        el.dataset.twReady = "1";

        const name = el.dataset.name || el.textContent || "";
        const reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        let alreadyTyped = false;
        try {
            alreadyTyped = sessionStorage.getItem(SESSION_KEY) === "1";
        } catch {
            alreadyTyped = false;
        }

        if (alreadyTyped || reduceMotion) {
            el.textContent = name;
            return;
        }

        el.textContent = "";
        if (role) role.style.opacity = "0";

        const caret = document.createElement("span");
        caret.className = "hero-caret";
        caret.setAttribute("aria-hidden", "true");
        el.appendChild(caret);

        let i = 0;
        let timer = 0;
        const TYPE_MS = 90;

        function type() {
            if (i < name.length) {
                caret.insertAdjacentText("beforebegin", name.charAt(i));
                i++;
                timer = window.setTimeout(type, TYPE_MS);
            } else {
                window.setTimeout(() => caret.remove(), 900);
                if (role) role.style.opacity = "1";
                try {
                    sessionStorage.setItem(SESSION_KEY, "1");
                } catch {}
            }
        }

        timer = window.setTimeout(type, 350);
        document.addEventListener(
            "astro:before-swap",
            () => window.clearTimeout(timer),
            { once: true },
        );
    }

    document.addEventListener("astro:page-load", initHero);
</script>
