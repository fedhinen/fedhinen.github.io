---
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';

interface Props {
    lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = await getCollection('projects', ({ data }) => {
    return data.lang === lang;
});

const sortedProjects = projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const projectsBase = lang === 'es' ? '/projects' : '/en/projects';
---

<section id="projects" class="py-16 md:py-24 scroll-mt-24">
    <div class="mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-primary tracking-tight">
            {t('section.projects')}
        </h2>
        <p class="text-text-muted mt-2">{t('projects.gallery.description')}</p>
    </div>

    {sortedProjects.length === 0 ? (
        <p class="text-gray-400">{t('projects.empty')}</p>
    ) : (
        <div class="grid grid-cols-1 md:grid-cols-[14rem_1fr] md:gap-14" data-proj-root>
            <!-- Menú sticky (izquierda) -->
            <aside class="order-1 mb-8 md:mb-0">
                <div class="md:sticky md:top-28">
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4 hidden md:block">
                        {t('projects.menu.title')}
                    </p>
                    <nav class="flex md:flex-col gap-1 overflow-x-auto md:overflow-visible pb-2 md:pb-0 md:border-l border-gray-200" data-proj-menu>
                        {sortedProjects.map((project) => (
                            <a
                                href={`#proj-${project.slug}`}
                                data-proj-link={project.slug}
                                class="proj-link md:-ml-px flex px-4 py-2 text-sm font-medium text-gray-400 hover:text-primary transition-colors whitespace-nowrap md:border-l-2 md:border-transparent rounded-md md:rounded-none"
                            >
                                <span class="truncate max-w-[9rem]">{project.data.title}</span>
                            </a>
                        ))}
                    </nav>
                    <a href={projectsBase} class="hidden md:inline-flex items-center gap-1 text-xs font-semibold text-gray-400 hover:text-primary transition-colors mt-5 px-4">
                        {t('projects.viewAll')}
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </aside>

            <!-- Lista de proyectos (derecha) -->
            <div class="order-2">
                {sortedProjects.map((project) => (
                    <a
                        id={`proj-${project.slug}`}
                        data-proj-panel={project.slug}
                        href={`${projectsBase}/${project.slug}`}
                        class="proj-reveal group block py-14 md:py-16 border-t border-gray-200/70 first:border-t-0 no-underline scroll-mt-28"
                    >
                        <div class="flex items-start justify-between gap-6">
                            <div class="min-w-0">
                                <h3 class="text-xl md:text-2xl font-bold text-primary tracking-tight group-hover:text-black transition-colors">
                                    {project.data.title}
                                </h3>
                                <p class="text-text-muted mt-2 text-[15px] leading-relaxed max-w-2xl">
                                    {project.data.description}
                                </p>
                                <div class="flex flex-wrap gap-2 mt-4">
                                    {project.data.tags.map((tag) => (
                                        <span class="text-xs font-medium text-text-muted border border-gray-200 rounded-full px-2.5 py-0.5">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            </div>
                            <span class="shrink-0 mt-1 text-gray-300 group-hover:text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
                            </span>
                        </div>
                    </a>
                ))}

                <a href={projectsBase} class="md:hidden inline-flex items-center gap-1 text-sm font-semibold text-gray-500 hover:text-primary transition-colors mt-8">
                    {t('projects.viewAll')}
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </div>
        </div>
    )}
</section>

<style>
    .proj-reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .proj-reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
    .proj-link.is-active {
        color: var(--color-primary);
    }
    @media (min-width: 768px) {
        .proj-link.is-active {
            border-left-color: var(--color-primary);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .proj-reveal {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }
</style>

<script>
    function initProjects() {
        const root = document.querySelector<HTMLElement>('[data-proj-root]');
        if (!root || root.dataset.projReady === '1') return;
        root.dataset.projReady = '1';

        const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-proj-panel]'));
        const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-proj-link]'));
        if (panels.length === 0) return;

        const revealObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        revealObserver.unobserve(entry.target);
                    }
                });
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );
        panels.forEach((p) => revealObserver.observe(p));

        function setActive(slug: string) {
            links.forEach((link) => {
                link.classList.toggle('is-active', link.dataset.projLink === slug);
            });
        }

        const spyObserver = new IntersectionObserver(
            (entries) => {
                const visible = entries
                    .filter((e) => e.isIntersecting)
                    .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
                if (visible) {
                    const slug = (visible.target as HTMLElement).dataset.projPanel;
                    if (slug) setActive(slug);
                }
            },
            { rootMargin: '-25% 0px -55% 0px', threshold: [0, 0.25, 0.5, 1] }
        );
        panels.forEach((p) => spyObserver.observe(p));
        setActive(panels[0].dataset.projPanel || '');

        document.addEventListener('astro:before-swap', () => {
            revealObserver.disconnect();
            spyObserver.disconnect();
        }, { once: true });
    }

    document.addEventListener('astro:page-load', initProjects);
</script>
