---
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';

interface Props {
    lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = await getCollection('projects', ({ data }) => {
    return data.lang === lang;
});

const sortedProjects = projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tagColors = [
    "bg-sky-50 text-sky-700 border-sky-100",
    "bg-indigo-50 text-indigo-700 border-indigo-100",
    "bg-rose-50 text-rose-700 border-rose-100",
    "bg-emerald-50 text-emerald-700 border-emerald-100",
    "bg-amber-50 text-amber-700 border-amber-100",
    "bg-violet-50 text-violet-700 border-violet-100",
];
---

<section id="projects" class="py-8">
    <div class="flex items-center gap-3 mb-10">
        <div class="h-px bg-gray-200 flex-1"></div>
        <h2 class="text-2xl font-bold text-primary tracking-tight">
             {t('section.projects')} <span class="text-gray-300 font-light text-lg ml-2">{sortedProjects.length}</span>
        </h2>
        <div class="h-px bg-gray-200 flex-1"></div>
    </div>

    {sortedProjects.length === 0 ? (
        <div class="p-8 border border-dashed border-gray-200 rounded-2xl text-center text-gray-400">
            <p>{t('projects.empty')}</p>
        </div>
    ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-8 relative">
            {sortedProjects.map((project, index) => {
                const isMedIndex = project.data.title.includes("MedIndex");
                
                return (
                <div class="relative group">
                    {/* Sticky Note for MedIndex */}
                    {isMedIndex && (
                        <div class="hidden md:block absolute -right-6 -top-6 transform rotate-3 z-20 w-32">
                           <div class="bg-yellow-50 border border-yellow-200 p-3 rounded-lg shadow-sm text-xs text-yellow-800 font-handwriting leading-tight relative">
                                <span class="absolute -left-2 top-4 w-3 h-px bg-yellow-300"></span>
                                "Nació de la necesidad: ¡no existía una API pública!"
                           </div>
                        </div>
                    )}

                    <article class="card-soft p-4 md:p-8 h-full flex flex-col hover:border-black/5 transition-all duration-300">
                        <div class="flex justify-between items-start mb-4">
                            <h3 class="text-xl font-bold text-primary tracking-tight">
                                <a href={`/${lang === 'es' ? 'projects' : 'en/projects'}/${project.slug}`} class="no-underline hover:text-black">
                                    {project.data.title}
                                </a>
                            </h3>
                             <a href={`/${lang === 'es' ? 'projects' : 'en/projects'}/${project.slug}`} class="text-gray-300 hover:text-black transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
                            </a>
                        </div>
                        
                        <p class="text-text-muted mb-8 text-sm leading-relaxed flex-1">
                            {project.data.description}
                        </p>
                        
                        <div class="flex flex-wrap gap-2 mt-auto">
                            {project.data.tags.map((tag, i) => (
                                <span class={`px-2.5 py-1 text-[11px] font-medium rounded-md border ${tagColors[i % tagColors.length]}`}>
                                    {tag}
                                </span>
                            ))}
                        </div>
                    </article>
                </div>
                )
            })}
        </div>
    )}
</section>
