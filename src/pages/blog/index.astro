---
import Layout from '../../layouts/Layout.astro';
import BlogList from '../../components/BlogList.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('es');
---

<Layout title={`Victor Ruiz - ${t('nav.blog')}`}>
    <div class="max-w-5xl mx-auto px-4 md:px-8 mt-12 mb-24">
         <header class="mb-16">
             <span class="badge-object mb-4 inline-block">{t('blog.object')}</span>
             <h1 class="text-5xl font-[800] tracking-tight text-primary mb-4">{t('nav.blog')}</h1>
             <p class="text-gray-500 text-lg max-w-2xl">{t('blog.gallery.description')}</p>
        </header>

        <BlogList lang="es" />
    </div>
</Layout>
